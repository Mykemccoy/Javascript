// --------------------------------------------------------------------
// STEP 1: Define Study Area
// --------------------------------------------------------------------
var table = ee.FeatureCollection('projects/ganga-region-surface-water-1/assets/Kaveri_River');
var studyarea = table.geometry();
var studyFeatureGeom = table.first().geometry(); // First feature for export/clip

// Center map manually
Map.setCenter(77.5, 12.0, 7);
Map.addLayer(studyarea, {color: 'blue'}, 'Study Area');

// --------------------------------------------------------------------
// STEP 2: Load Landsat-8 Collection
// --------------------------------------------------------------------
var landsat8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
  .filterBounds(studyarea)
  .filterDate('2020-01-01', '2024-01-01')
  .filter(ee.Filter.lt('CLOUD_COVER', 10));

// Apply scaling factors to Landsat-8
function applyScale(image) {
  var optical = image.select('SR_B.*').multiply(0.0000275).add(-0.2).float();
  var thermal = image.select('ST_B.*').multiply(0.00341802).add(149.0).float();
  return image.addBands(optical, null, true)
              .addBands(thermal, null, true);
}

var rescaled = landsat8.map(applyScale);
var image = rescaled.median().clip(studyarea);

Map.addLayer(image, {bands:['SR_B4','SR_B3','SR_B2'], min:0, max:0.3}, 'Landsat Image');

// Define bands for classification
var bands = ['SR_B2','SR_B3','SR_B4','SR_B5','SR_B6','SR_B7','ST_B10'];


// --------------------------------------------------------------------
// STEP 3: Load Training Points from CSV Asset (MODIFIED)
// --------------------------------------------------------------------
// !!! IMPORTANT: Replace this placeholder with your actual Asset ID after uploading the CSV.
var training_csv_asset = ee.FeatureCollection('projects/ganga-region-surface-water-1/assets/CNN_Training_Data');

// The CSV already contains the sampled band values and the 'Class' property.
var trainImage = training_csv_asset;

// Check the number of training points loaded
print('Total Training Points from CSV:', trainImage.size());

// --------------------------------------------------------------------
// STEP 4: Prepare Data for Training (MODIFIED - No sampling needed)
// --------------------------------------------------------------------
// Split the new, larger dataset into training and testing sets.
var trainingData = trainImage.randomColumn();
var trainSet = trainingData.filter(ee.Filter.lt('random',0.8));
var testSet  = trainingData.filter(ee.Filter.gte('random',0.8));

print('Training Set Size:', trainSet.size());
print('Testing Set Size:', testSet.size());

// --------------------------------------------------------------------
// STEP 5: Train Random Forest Classifier
// --------------------------------------------------------------------
var classifier = ee.Classifier.smileRandomForest(10)
  .train({
    features: trainSet,
    classProperty: 'Class',
    inputProperties: bands
  });

// Classify image
var classified = image.select(bands).classify(classifier).clip(studyFeatureGeom);
// Class values: Waterbody=0, Urban=1, Vegetation=2, Barren=3
var palette = ['#0c2c84', '#e31a1c', '#005a32', '#fed976'];
Map.addLayer(classified, {palette:palette, min:0, max:3}, 'Classified Image');

// --------------------------------------------------------------------
// STEP 6: Accuracy Assessment
// --------------------------------------------------------------------
var confusionMatrix = testSet.classify(classifier).errorMatrix({
  actual: 'Class',
  predicted: 'classification'
});
print('Confusion Matrix:', confusionMatrix);
print('Overall Accuracy:', confusionMatrix.accuracy());
print('Producers Accuracy:', confusionMatrix.producersAccuracy());
print('Consumers Accuracy:', confusionMatrix.consumersAccuracy());

// --------------------------------------------------------------------
// STEP 7: Variable Importance
// --------------------------------------------------------------------
var explain = classifier.explain();
var variableImportance = ee.Feature(null, ee.Dictionary(explain).get('importance'));
print('Variable Importance:', variableImportance);

var chart = ui.Chart.feature.byProperty(variableImportance)
  .setChartType('BarChart')
  .setOptions({
    title:'Random Forest Variable Importance',
    legend:{position:'none'},
    hAxis:{title:'Importance'},
    vAxis:{title:'Bands'}
  });
chart.style().set({position:'bottom-left', width:'400px', height:'400px'});
print(chart);

// --------------------------------------------------------------------
// STEP 8: Export Classified Image (MODIFIED: Added PNG Export)
// --------------------------------------------------------------------

// 1. Define Visualization Parameters
var vizParams = {
  min: 0,
  max: 3,
  palette: palette // Use the same palette defined above
};

// 2. Generate a PNG Thumbnail Download URL for visualization
var classifiedRGB = classified.visualize(vizParams);
var thumbnailURL = classifiedRGB.getThumbURL({
  params: {
    region: studyFeatureGeom,
    dimensions: 1024, // High-quality image size for visualization
    format: 'png'
  }
});
print('PNG Visualization Download URL:', thumbnailURL); // <-- Click this link in the console to download the PNG!

// 3. Export the full classified image (GeoTIFF) for geospatial analysis
Export.image.toDrive({
  image: classified,
  description: 'Landsat_RF_Classification_GeoTIFF',
  scale: 30,
  region: studyFeatureGeom,
  maxPixels: 1e13
});
